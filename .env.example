# PostgreSQL (Neon / pgvector) — vector store for CPT code retrieval
PGHOST=<your-pg-pooler-host>
PGHOST_UNPOOLED=<your-pg-direct-host>
PGUSER=<pg-username>
PGDATABASE=<pg-database-name>
PGPASSWORD=<pg-password>
PGPORT=5432

# MySQL (AWS RDS) — clinical notes source
DB_USERNAME=<mysql-username>
DB_PASSWORD=<mysql-password>
DB_NAME=<mysql-database-name>
DB_HOST=<rds-writer-endpoint>
DB_PORT=3306

# OpenAI
OPENAI_API_KEY=sk-proj-...
TEMPERATURE=0.0
MAX_TOKENS=4096
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini

# Tavily (web search for CPT boundary lookups)
TAVILY_API_KEY=tvly-...

# Uvicorn (optional overrides — defaults work in Docker)
APP_HOST=0.0.0.0
APP_PORT=8002
APP_RELOAD=false
